DATABASE_URL=postgresql://atleta:atleta@localhost:5432/atleta
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
PORT=3001

# Seeds: cuentas de prueba + catálogo público de ejercicios con video (idempotente). Catálogos se siembran siempre.
SEED_DEMO_DATA=true

# IA — reportes de progreso (Gemini). Opcional: sin clave la API arranca igual
GEMINI_API_KEY=
# IA — autofill de ejercicios (GPT-4o-mini). Opcional
OPENAI_API_KEY=

# Resend (email). Opcional en local: sin clave los enlaces se imprimen en consola
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Google OAuth. Opcional: sin estas variables el login con Google se desactiva
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
