NEXT_PUBLIC_API_URL=http://localhost:3001

# Secreto compartido con la API (mismo valor que WEB_PROXY_SECRET en apps/api). Solo servidor: el middleware firma
# las peticiones que reenvía a la API para que los límites de login usen la IP real del usuario.
# Genéralo con `openssl rand -hex 32`. En local es opcional. Ver docs/deploy.md.
WEB_PROXY_SECRET=
